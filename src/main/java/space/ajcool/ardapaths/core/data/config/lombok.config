# These types are Gson-deserialized and depend on an implicit no-arg constructor plus
# final-collection field initializers. Any generated constructor breaks that silently.
lombok.allArgsConstructor.flagUsage      = error
lombok.requiredArgsConstructor.flagUsage = error
lombok.noArgsConstructor.flagUsage       = error
lombok.builder.flagUsage                 = error

# Chained setters are the existing house style for the config DTOs.
lombok.accessors.chain = true
