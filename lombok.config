# Root of the project - do not look for lombok.config further up the tree.
config.stopBubbling = true

# Tag generated members with @lombok.Generated (coverage / reflection introspection).
lombok.addLombokGeneratedAnnotation = true

# Never emit @java.beans.ConstructorProperties.
lombok.anyConstructor.addConstructorProperties = false

# Carry nullability contracts from fields onto generated accessors and setter params.
lombok.copyableAnnotations += org.jetbrains.annotations.NotNull
lombok.copyableAnnotations += org.jetbrains.annotations.Nullable

# Features we do not want in this codebase.
lombok.data.flagUsage      = error
lombok.value.flagUsage     = error
lombok.val.flagUsage       = error
lombok.var.flagUsage       = error
lombok.cleanup.flagUsage   = error
lombok.sneakyThrows.flagUsage = error
